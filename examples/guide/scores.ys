export fn make_scores() -> [i32] {
    let scores = new [i32](3)
    scores[0] = 10
    scores[1] = 20
    scores[2] = 30
    return scores
}

export fn sum(scores: [i32]) -> i32 {
    var total = 0
    for i in 0 .. scores.length {
        total = total + scores[i]
    }
    return total
}

fn main() {
    print(sum(make_scores()))
}
