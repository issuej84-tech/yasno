fn is_prime(number: i32) -> bool {
    var divisor = 2
    while divisor <= number / divisor {
        if number % divisor == 0 {
            return false
        }
        divisor = divisor + 1
    }
    return true
}

export fn count_primes(limit: i32) -> i32 {
    var count = 0
    for number in 2 .. limit {
        if is_prime(number) {
            count = count + 1
        }
    }
    return count
}

export fn checksum(rounds: u32, seed: u32) -> u32 {
    var state = seed
    for i in 0u32 .. rounds {
        state = state ^ (state >> 16u32)
        state = state * 0x7feb_352du32 + i
    }
    return state
}
